#include<bits/stdc++.h>
using namespace std;
long long a[5005],vis[1000006],n;
// bool exist[1000005];
// void findyin(long long a){
//     if(exist[a])return;
//     for(int i=1;i<=sqrt(a)+1;i++){
//         if(a%i==0){
//             exist[i]=1;
//             exist[a/i]=1;
//         }
//     }
// }
int main(){
    freopen("stable.in","r",stdin);
    freopen("stable.out","w",stdout);
    cin>>n;
    long long maxai=-1e9;
    for(int i=1;i<=n;++i){
        cin>>a[i];
        maxai=max(maxai,a[i]);
    }
    for(int i=1;i<=n;++i){
        for(int j=i+1;j<=n;++j){
            vis[abs(a[i]-a[j])]=1;
        }
    }
    for(int i=n;i<1e6+5;++i){
        if(!vis[i]){
            long long fl=1;
            for(int j=i;j<1e6+5;j+=i){
                if(vis[j]){
                    fl=0;
                    break;
                }
            }
            if(fl){
                cout<<i;
                return 0;
            }
        }
    }
    return 0;
}

