# ============================================================
#  OI 仓库 .gitignore
#  原则：只提交 源码 + 题解 + 小规模数据
#        不提交 编辑器配置 / 编译产物 / 大文件
# ============================================================

# ---------- 编辑器与 IDE 配置 ----------
.cph/
.vscode/
.vs/

# ---------- 编译产物 ----------
*.exe
*.o
*.obj
*.pdb
*.idb
*.ipch
*.tlog
*.lastbuildstate
*.opendb
*.suo
*.user
*.vcxproj
*.vcxproj.*
*.filters
*.sln
unsuccessfulbuild

# ---------- 编辑器自动备份 ----------
*.cpp#
*.bak

# ---------- 大文件（GitHub 单文件上限 100MB；iso 3.4G / AppImage 132M / zip 138M）----------
*.iso
*.AppImage
*.zip

# ---------- 系统临时文件 ----------
Thumbs.db
desktop.ini
.DS_Store
*.tmp

